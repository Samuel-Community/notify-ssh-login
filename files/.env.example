BOTNAME="SSH-Notify"
AVATAR_URL="https://icons.iconarchive.com/icons/blackvariant/button-ui-system-apps/512/Terminal-icon.png"
WEBHOOK=""

ONLY_ROOT=false
EXCLUDE_USERS="backup www-data"

# Vide pour désactiver
QUIET_HOURS="23-6"

# ipapi | ipinfo | none
GEOIP_METHOD="ipapi"

MAIL_TO=""
MAIL_FROM="ssh-notify@$(hostname -f)"
MAIL_SUBJECT="[SSH-Notify] Rapport hebdomadaire"

LOG_FILE="/var/log/ssh-notify.log"
DEBUG_LOG="/var/log/ssh-notify.debug.log"
DEBUG=false

LOCAL_POLICY="label"     # label | mute | notify
LOCAL_GEOIP=false
SHOW_IFACE_LOCAL=true

TIMEOUT_SECS=4
RETRY_COUNT=2
DEDUP_WINDOW_SECS=10
